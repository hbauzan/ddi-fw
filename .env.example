# ddi-fw — plantilla de entorno. Copiá a `.env` y completá. Nunca commitees `.env`.

# --- Proxy / upstream LLM ----------------------------------------------------
DDI_UPSTREAM_URL=http://127.0.0.1:11434/v1
DDI_UPSTREAM_MODEL=llama3.2
DDI_HOST=127.0.0.1
DDI_PORT=8080
DDI_REQUEST_TIMEOUT_SECONDS=60

# --- Política de contención (demo: python-only) ------------------------------
DDI_ALLOWED_ALMA=python
DDI_FORBIDDEN_ALMAS=receta,legal

# --- Embedder y artefactos de calibración ------------------------------------
DDI_EMBEDDER=bge-m3
DDI_ROWS_PATH=ddi_fw/out/rows.npz
DDI_OUT_DIR=ddi_fw/out
